# Copy to .env.local for local dev. Never commit real values.

# ---- Azure DevOps ----
# The org name (from https://dev.azure.com/<ORG>/)
ADO_ORG=YourOrgName

# The exact project name (e.g., "Force Account Automation" — case-sensitive, spaces OK)
ADO_PROJECT=Your Project Name

# Personal Access Token with "Work Items: Read, write, & manage" scope
# Create at: https://dev.azure.com/<ORG>/_usersSettings/tokens
ADO_PAT=

# ---- Behavior ----
# How long to cache /api/tasks response (seconds). 5 min is the default.
CACHE_TTL_S=300

# Optional: enables the /api/admin/* migration endpoints. Leave empty to disable.
# When set, all admin calls must include header: X-Admin-Secret: <value>
ADMIN_SECRET=

# ---- Azure resources (populated by `npm run setup`) ----
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=eastus
AZURE_STATIC_WEB_APP_NAME=
