# Optional file — the setup wizard writes what it needs directly to Azure app settings.
# You only need this if you're running `npm run dev:api` locally and want to override.

# Local dev — mirror what the SWA has for its app settings
KEYVAULT_URI=https://<your-vault>.vault.azure.net/
STORAGE_ACCOUNT_NAME=<your-storage-account>
PROJECTS_TABLE_NAME=projects
CACHE_TTL_S=300

# For manual redeploys via infra/deploy.sh
AZURE_STATIC_WEB_APP_NAME=
